            },
            "id": "6a89c8bdd27a55886cc615aa"
          },
          {
            "question": "Când se țin ședințele săptămânale?",
            "answerSource": "manual",
            "answer": {
              "root": {
                "children": [
                  {
                    "children": [
                      {
                        "detail": 0,
                        "format": 0,
                        "mode": "normal",
                        "style": "",
                        "text": "Ședințele săptămânale ale clubului se țin in fiecare duminica, la ora 13. In functie de disponibilitate, ședințele se țin la Hotel Cișmigiu.",
                        "type": "text",
                        "version": 1
                      }
                    ],
                    "direction": null,
                    "format": "",
                    "indent": 0,
                    "type": "paragraph",
                    "version": 1,
                    "textFormat": 0,
                    "textStyle": ""
                  }
                ],
                "direction": null,
                "format": "",
                "indent": 0,
                "type": "root",
                "version": 1
              }
            },
            "id": "6a9450e97dfb8f4049cf55d3"
          },
          {
            "question": "Ce discutăm la ședințele săptămânale?",
            "answerSource": "manual",
            "answer": {
              "root": {
                "children": [
                  {
                    "children": [
                      {
                        "detail": 0,
                        "format": 0,
                        "mode": "normal",
                        "style": "",
                        "text": "La ședințele săptămânale ale clubului discutăm despre update-uri legate de evenimentele clubului, noutăți din district, sau din club.",
                        "type": "text",
                        "version": 1
                      }
