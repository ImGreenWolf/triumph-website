        "faqs": [
          {
            "question": "Cum mă pot înscrie?",
            "answerSource": "recruitment",
            "answer": {
              "root": {
                "children": [
                  {
                    "children": [
                      {
                        "detail": 0,
                        "format": 0,
                        "mode": "normal",
                        "style": "",
                        "text": "Exista 2 perioade de inscriere in club, toamna, si primavara. Pâna pe 25 septembrie, este deschis formularul de recrutare de toamna.",
                        "type": "text",
                        "version": 1
                      }
                    ],
                    "direction": null,
                    "format": "",
                    "indent": 0,
                    "type": "paragraph",
                    "version": 1,
                    "textFormat": 0,
                    "textStyle": ""
                  }
                ],
